---
interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  type?: 'website' | 'article';
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  canonical,
  // TODO: Replace this SVG with /og-default.png once the owner supplies a 1200x630 PNG.
  ogImage = '/og-default.svg',
  type = 'website',
  structuredData,
} = Astro.props;

const canonicalUrl = new URL(canonical, Astro.site).toString();
const imageUrl = new URL(ogImage, Astro.site).toString();
const jsonLd = structuredData ? JSON.stringify(structuredData) : null;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<meta name="robots" content="index,follow" />

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<!-- Google tag (gtag.js) -->
<script is:inline>
  (() => {
    const productionHosts = new Set(['isbuyerlegit.com', 'www.isbuyerlegit.com']);

    if (!productionHosts.has(window.location.hostname)) {
      return;
    }

    const script = document.createElement('script');
    script.async = true;
    script.src = 'https://www.googletagmanager.com/gtag/js?id=G-HPZ6MC36RX';
    document.head.appendChild(script);

    window.dataLayer = window.dataLayer || [];
    window.gtag = window.gtag || function gtag() {
      window.dataLayer.push(arguments);
    };

    window.gtag('js', new Date());
    window.gtag('config', 'G-HPZ6MC36RX');
  })();
</script>

{jsonLd ? <script type="application/ld+json" set:html={jsonLd} /> : null}
