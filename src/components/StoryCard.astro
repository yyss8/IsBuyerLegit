---
interface StoryData {
  title: string;
  description: string;
  type: string;
  platform: 'ebay' | 'local';
  outcome: 'scammed' | 'safe';
  date: Date;
}

interface Props {
  href: string;
  story: StoryData;
}

const { href, story } = Astro.props;
const outcomeClass = story.outcome === 'scammed'
  ? 'border-[var(--danger)] text-[var(--danger)]'
  : 'border-[var(--safe)] text-[var(--safe)]';
const outcomeLabel = story.outcome === 'scammed' ? 'Scammed' : 'Avoided loss';
---

<article class="group relative h-full border border-[var(--rule)] bg-[var(--surface)] p-5 transition hover:-translate-y-0.5 hover:border-[var(--ink-soft)]">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <span class="rounded-full border border-[var(--rule)] px-2.5 py-1 text-xs font-bold uppercase tracking-wide text-[var(--muted)]">
      {story.type}
    </span>
    <span class={`rounded-full border px-2.5 py-1 text-xs font-bold uppercase tracking-wide ${outcomeClass}`}>
      {outcomeLabel}
    </span>
  </div>
  <h3 class="display-font mt-5 text-xl font-bold leading-tight text-[var(--ink)]">
    <a class="after:absolute after:inset-0" href={href}>{story.title}</a>
  </h3>
  <p class="mt-3 leading-relaxed text-[var(--muted)]">{story.description}</p>
  <p class="mt-5 text-sm font-bold text-[var(--ink)] group-hover:text-[var(--ink-soft)]">Read the breakdown</p>
</article>
