---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const stories = await getCollection('stories', ({ data }) => !data.draft);

  return stories.map((story) => ({
    params: { slug: story.id.replace(/\.mdx?$/, '') },
    props: { story },
  }));
}

const { story } = Astro.props;
const { Content } = await render(story);
const storyPath = `/stories/${story.id.replace(/\.mdx?$/, '')}/`;
const datePublished = story.data.date.toISOString();
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: story.data.title,
  description: story.data.description,
  datePublished,
  author: {
    '@type': 'Organization',
    name: 'IsBuyerLegit',
    url: 'https://isbuyerlegit.com/',
  },
  publisher: {
    '@type': 'Organization',
    name: 'IsBuyerLegit',
    url: 'https://isbuyerlegit.com/',
  },
  mainEntityOfPage: `https://isbuyerlegit.com${storyPath}`,
};

const outcomeClass = {
  scammed: 'border-[var(--danger)] text-[var(--danger)]',
  safe: 'border-[var(--safe)] text-[var(--safe)]',
  declined: 'border-[var(--rule)] text-[var(--ink-soft)]',
}[story.data.outcome];
const defaultOutcomeLabels = {
  scammed: 'Scammed',
  safe: 'Avoided loss',
  declined: 'Declined',
};
const outcomeLabel = story.data.outcomeLabel ?? defaultOutcomeLabels[story.data.outcome];
const whatToDoParagraphs = story.data.whatToDo
  .split(/\n{2,}/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);
---

<BaseLayout
  title={story.data.title}
  description={story.data.description}
  canonical={storyPath}
  active="stories"
  type="article"
  structuredData={structuredData}
>
  <main class="mx-auto max-w-4xl px-5 py-14 md:px-8">
    <a class="text-sm font-bold text-[var(--muted)] underline underline-offset-4 hover:text-[var(--ink)]" href="/stories/">
      Back to stories
    </a>
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <span class="rounded-full border border-[var(--rule)] px-2.5 py-1 text-xs font-bold uppercase tracking-wide text-[var(--muted)]">
        {story.data.type}
      </span>
      <span class={`rounded-full border px-2.5 py-1 text-xs font-bold uppercase tracking-wide ${outcomeClass}`}>
        {outcomeLabel}
      </span>
    </div>
    <h1 class="display-font mt-5 text-4xl font-bold leading-tight tracking-tight md:text-6xl">
      {story.data.title}
    </h1>
    <p class="mt-5 text-lg leading-8 text-[var(--muted)]">{story.data.description}</p>

    <section class="mt-12 border border-[var(--rule)] bg-[var(--surface)] p-6">
      <h2 class="display-font text-3xl font-bold">What happened</h2>
      <div class="prose prose-neutral mt-6 max-w-none prose-p:text-[var(--ink)] prose-p:leading-8">
        <Content />
      </div>
    </section>

    <section class="mt-8 border border-[var(--rule)] bg-[var(--ink)] p-6 text-[var(--paper)]">
      <div>
        <h2 class="display-font text-3xl font-bold">The red flags</h2>
        <p class="mt-3 leading-7 text-[#EFE9DD]">
          The signals below are the ones that mattered in this case.
        </p>
      </div>
      <div class="mt-6">
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {story.data.redFlags.map((flag, index) => (
            <li class={`border-l-4 bg-white/5 px-4 py-3 ${story.data.outcome === 'declined' ? 'border-l-[var(--caution)]' : story.data.outcome === 'scammed' || index === 0 ? 'border-l-[var(--danger)]' : 'border-l-[var(--caution)]'}`}>
              {flag}
            </li>
          ))}
        </ul>
      </div>

      <div class="mt-8 border-t border-white/20 pt-8">
        <h2 class="display-font text-3xl font-bold">What to do</h2>
        <div class="mt-3 space-y-4 leading-8 text-[#EFE9DD]">
          {whatToDoParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>

      <a class="mt-8 inline-flex border border-[var(--paper)] px-5 py-3 text-sm font-bold text-[var(--paper)] hover:bg-[var(--paper)] hover:text-[var(--ink)]" href="/check/">
        Not sure about your own buyer? Run the 60-second check.
      </a>
    </section>

    <section class="mt-8 border border-[var(--rule)] bg-[var(--surface)] p-5" aria-label="Save or share this story">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm font-semibold text-[var(--muted)]">Save this for the next time a buyer feels off.</p>
        <div class="flex flex-wrap gap-3">
          <button
            class="hidden border border-[var(--ink)] px-4 py-2 text-sm font-bold text-[var(--ink)] hover:bg-[var(--ink)] hover:text-[var(--paper)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--ink)]"
            type="button"
            data-story-share
          >
            Share
          </button>
          <button
            class="border border-[var(--ink)] bg-[var(--ink)] px-4 py-2 text-sm font-bold text-[var(--paper)] hover:bg-transparent hover:text-[var(--ink)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--ink)]"
            type="button"
            data-story-copy
          >
            Copy link
          </button>
        </div>
      </div>
      <p class="mt-3 min-h-5 text-sm font-semibold text-[var(--muted)]" aria-live="polite" data-story-share-status></p>
    </section>

    <section class="mt-8 border border-[var(--rule)] bg-[var(--surface)] p-6">
      <h2 class="display-font text-2xl font-bold">Sources</h2>
      <ul class="mt-4 space-y-3 leading-7 text-[var(--muted)]">
        {story.data.sources.map((source) => (
          <li>
            {source.url ? (
              <a
                class="font-semibold text-[var(--ink)] underline underline-offset-4 hover:text-[var(--ink-soft)]"
                href={source.url}
                target="_blank"
                rel="noopener"
              >
                {source.title}
              </a>
            ) : (
              <span>{source.title}</span>
            )}
          </li>
        ))}
      </ul>
    </section>

    <script is:inline>
      (() => {
        const shareButton = document.querySelector('[data-story-share]');
        const copyButton = document.querySelector('[data-story-copy]');
        const status = document.querySelector('[data-story-share-status]');

        if (!copyButton || !status) {
          return;
        }

        const setStatus = (message) => {
          status.textContent = message;

          if (message) {
            window.setTimeout(() => {
              if (status.textContent === message) {
                status.textContent = '';
              }
            }, 2400);
          }
        };

        const copyCurrentUrl = async () => {
          const url = window.location.href;

          if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(url);
            return;
          }

          const textArea = document.createElement('textarea');
          textArea.value = url;
          textArea.setAttribute('readonly', '');
          textArea.style.position = 'fixed';
          textArea.style.top = '-1000px';
          document.body.appendChild(textArea);
          textArea.select();
          document.execCommand('copy');
          textArea.remove();
        };

        if (shareButton && navigator.share) {
          shareButton.classList.remove('hidden');
          shareButton.addEventListener('click', async () => {
            try {
              await navigator.share({
                title: document.title,
                url: window.location.href,
              });
            } catch (error) {
              if (error instanceof DOMException && error.name === 'AbortError') {
                return;
              }

              setStatus('Share is not available here.');
            }
          });
        }

        copyButton.addEventListener('click', async () => {
          try {
            await copyCurrentUrl();
            setStatus('Copied.');
          } catch {
            setStatus('Copy failed.');
          }
        });
      })();
    </script>
  </main>
</BaseLayout>
