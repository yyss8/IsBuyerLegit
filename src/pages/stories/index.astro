---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryCard from '../../components/StoryCard.astro';

const title = 'Real marketplace scam stories, broken down';
const description = 'Read real marketplace scam cases with the red flags marked, the outcome explained, and the practical next step made clear.';
const stories = (await getCollection('stories', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title={title} description={description} canonical="/stories/" active="stories">
  <main class="mx-auto max-w-6xl px-5 py-14 md:px-8">
    <p class="text-sm font-bold uppercase tracking-[0.22em] text-[var(--ink-soft)]">Case library</p>
    <h1 class="display-font mt-4 text-4xl font-bold leading-tight tracking-tight md:text-6xl">
      Real marketplace scam stories, broken down.
    </h1>
    <p class="mt-6 max-w-3xl text-lg leading-8 text-[var(--muted)]">
      Real cases with the red flags marked, the outcome explained, and the practical next step made clear.
    </p>

    <div class="mt-10 grid gap-4 md:grid-cols-3">
      {stories.map((story) => (
        <StoryCard href={`/stories/${story.id.replace(/\.mdx?$/, '')}/`} story={story.data} />
      ))}
    </div>
  </main>
</BaseLayout>
